{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The shell page: tabs, settings, link routing. Only the `shell` webview, never a module webview.",
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "store:default",
    "log:default",
    "opener:default",
    "allow-module-open",
    "allow-module-bounds",
    "allow-module-hide",
    "allow-module-reload",
    "allow-probe",
    "allow-studio-status",
    "allow-studio-launch"
  ]
}
