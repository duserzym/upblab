{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPb Studio",
  "mainBinaryName": "upbstudio",
  "version": "0.1.0",
  "identifier": "edu.umn.upbstudio",
  "build": {
    "beforeDevCommand": "pnpm --filter upbstudio-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter upbstudio-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "One window for the lab's LA-ICP-MS workflow",
    "longDescription": "UPb Studio hosts grainatlas (Images), laicpmsdb (Sessions) and launches UPbRPy Studio (Reduce), with links between them.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["laicpmsdb", "grainatlas", "upbr"]
      }
    }
  }
}
