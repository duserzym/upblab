{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPb Lab",
  "mainBinaryName": "upbstudio",
  "version": "0.1.15",
  "identifier": "edu.umn.upbstudio",
  "build": {
    "beforeDevCommand": "pnpm --filter upbstudio-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter upbstudio-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "One window for the lab's LA-ICP-MS workflow",
    "longDescription": "UPb Lab hosts grainatlas (Images), UPbDB (Sessions) and launches UPbRPy Studio (Reduce), with links between them.",
    "copyright": "MIT License",
    "fileAssociations": [
      {
        "ext": ["zag"],
        "name": "TM4000 package",
        "description": "Hitachi TM4000 navigation file: opens its package in Images",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["grainatlas"],
        "name": "Folder",
        "description": "grainatlas project, or any folder: opened in the tab that reads it",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["public.folder"]
      }
    ],
    "resources": {
      "resources/upbdb-service/": "upbdb-service/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRTAyNEFEMjVCMUUxMTcKUldRWDRiRWxyU1RnekxYNmN2eFV2YVJVSUVLRGd4UDdjSnh3aTFvRm1qd0EycCtWRTk3U1VkRzAK",
      "endpoints": ["https://github.com/duserzym/upblab/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["upbdb", "grainatlas", "upbr"]
      }
    }
  }
}
