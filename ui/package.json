{
  "name": "upbstudio-ui",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "UPb Lab shell UI (Svelte 5): tab bar, Home, Settings, link resolver; runs in Tauri and at /desk/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lab/bridge": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
